# =============================================================================
# Agent Engine — 启动参数配置
#
# 本文件只包含服务启动时必须提前确定的参数。
# 其他用户可调配置（模型、Agent 参数、技能路径等）请通过 UI 设置页面配置，
# 数据将安全地存储在数据库中。
#
# 使用方法：cp .env.example .env，然后填写必要的值
# =============================================================================

# ── 服务器 ────────────────────────────────────────────────────────────────────
# 服务监听端口和地址（DB 初始化前使用，必须在此配置）
PORT=12323
HOST=0.0.0.0

# ── 数据库 ────────────────────────────────────────────────────────────────────
# 数据库文件路径（决定 DB 位置本身，不能存 DB）
DB_PATH=./data/agent.db

# ── 加密密钥（必填）──────────────────────────────────────────────────────────
# 用于加密数据库中的敏感数据（API Key 等），必须在首次启动前设置。
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️  警告：一旦设置，切勿修改，否则已加密的数据将无法解密。
ENCRYPTION_KEY=your-64-hex-char-key-here

# ── 鉴权（可选）──────────────────────────────────────────────────────────────
# 是否启用 JWT 鉴权（默认 true，设为 false 可关闭）
# AUTH_ENABLED=true
# JWT_SECRET=your-jwt-secret-here

# ── 日志级别（可选）──────────────────────────────────────────────────────────
# 可选值: trace | debug | info | warn | error（默认 info）
# LOG_LEVEL=info

# =============================================================================
# 以下为「保底回退值」
#
# 这些值在数据库中尚无配置时生效（例如首次部署）。
# 通过 UI 设置页面保存后，数据库值将自动覆盖以下配置，届时可将其删除。
# =============================================================================

# ── 默认模型（保底）──────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_PRIMARY_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# OLLAMA_BASE_URL=http://localhost:11434

# ── Agent 参数（保底）────────────────────────────────────────────────────────
# MAX_ITERATIONS=50
# TOKEN_BUDGET=80000
# HISTORY_MAX_TOKENS=20000
# TOOL_OUTPUT_MAX_CHARS=4000
# COMPRESS_THRESHOLD_RATIO=0.5

# ── 技能（保底）──────────────────────────────────────────────────────────────
# SKILLS_ROOT=./skills
# BASH_PATH=C:/Program Files/Git/bin/bash.exe