# ── Server ───────────────────────────────────────────────────────────────────
PORT=12323
HOST=0.0.0.0

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: openai | anthropic
LLM_PROVIDER=openai
LLM_PRIMARY_MODEL=gpt-4o

# OpenAI (or compatible proxy)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (optional, if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=file:./data/agent.db

# ── Agent ────────────────────────────────────────────────────────────────────
MAX_ITERATIONS=100
TOKEN_BUDGET=100000

# Max tokens for conversation history window (lower = cheaper per call, default 20000)
HISTORY_MAX_TOKENS=20000
# Max chars for tool output before truncation (head+tail, default 4000)
TOOL_OUTPUT_MAX_CHARS=4000
# Compression trigger ratio of tokenBudget (lower = compress earlier, default 0.5)
COMPRESS_THRESHOLD_RATIO=0.5

# ── Skills ───────────────────────────────────────────────────────────────────
# Absolute or relative path to the skills directory
SKILLS_ROOT=./skills

# Path to bash executable (required for run_skill_script on Windows)
BASH_PATH=C:/Program Files/Git/bin/bash.exe

# ── Encryption ────────────────────────────────────────────────────────────────
# Required: 64 hex characters (32 bytes). Used to encrypt sensitive data like API keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: Once set, do NOT change this key or all encrypted data will be lost.
ENCRYPTION_KEY=your-64-hex-char-encryption-key-here

# ── Auth (optional) ───────────────────────────────────────────────────────────
# JWT_SECRET=your-secret-here
# OIDC_ISSUER_URL=http://localhost:3000
AUTH_ENABLED=true

# ── Observability ─────────────────────────────────────────────────────────────
QA_LOG_ENABLED=false
QA_LOG_DIR=./logs/qa