# Aether Engine 启动配置示例（源码核对：2026-11-17）
# 复制为 .env 后按部署填写；不要提交真实凭据。
# 当前 shell 已设置的变量不会被 .env 覆盖。
# 启动链：环境/.env → 用户/项目 aether 配置 → SQLite 可变配置 → managed 配置。
# HOST/PORT 在 DB 初始化前捕获；可信启动项不允许被设置 API/DB 覆盖。
# 不同配置键有不同生效阶段，不能把所有键都理解为可热更新。
# 详细说明：docs/docs/getting-started.md、docs/runtime-guide.md。

# 服务监听。引擎源码默认 HOST=0.0.0.0；本机独立使用建议明确绑定 loopback。
# AETHER_ENGINE_HOST / AETHER_ENGINE_PORT 优先于 HOST / PORT。
# HOST=127.0.0.1
# PORT=12323

# DATA_DIR 是 SQLite 文件路径，不是目录；相关 JSONL/正文和运行数据不只在此文件。
# DATA_DIR=./data/agent.db
# WORKSPACE_ROOT=./workspace

# 稳定加密密钥：32 字节、64 位十六进制。首次配置后安全备份。
# 丢失/随意更换会导致已加密数据不可读。源码开发 fallback 不适合生产。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=<64 hex characters>

# 鉴权默认开启。false 只允许无凭据请求作为本机 default 身份；
# 已识别的非空 API Key / Bearer 凭据验证失败仍拒绝；未知认证方案按匿名处理。
# 实例门禁、账号会话与路径授权独立生效，远端部署不要关闭用户认证。
# AUTH_ENABLED=true
# JWT_SECRET=<operator-managed secret>
# AETHER_INSTANCE_TOKEN=<operator-managed instance token>
# AETHER_ACCOUNT_REGISTRATION=true

# 第三方登录：管理员提供 OIDC/OAuth2/credential 配置；重启生效。
# 完整参数见 docs/account-external-login.md，不要把 clientSecret 放到前端。
# AETHER_ACCOUNT_PROVIDERS_JSON=[]
# AETHER_ACCOUNT_PUBLIC_URL=https://aether.example.com

# 命令运行时：鉴权默认 restricted-files；docker 需先部署固定镜像。
# host 仅接受 AUTH_ENABLED=false，不是隔离环境。
# 见 deploy/workspace-runtime/README.md。
# AETHER_WORKSPACE_RUNTIME=restricted-files
# AETHER_WORKSPACE_IMAGE=registry.example.com/aether@sha256:<64 hex characters>

# 模型保底值；优先在当前 UI 配置并启用模型。
# 单次请求/Agent/数据库/提供方适配还可能进一步决定实际模型和凭据。
# LLM_PROVIDER=openai
# LLM_PRIMARY_MODEL=<configured model id>
# OPENAI_API_KEY=<model provider key>
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=<model provider key>
# OLLAMA_BASE_URL=http://localhost:11434

# 上下文策略窗口默认 268000，不会把实际模型窗口扩容。
# 有效窗口还受模型能力和显式运行预算约束。
# CONTEXT_WINDOW_BUDGET=268000
# COMPRESS_THRESHOLD_RATIO=0.92
# TOOL_OUTPUT_MAX_CHARS=4000
# MAX_ITERATIONS / TOKEN_BUDGET 是旧配置名，不再作为产品默认强制停止上限。
# 不要靠调大它们承诺任务必然完成；显式调用预算和取消仍有效。

# OSM 当前配置名与默认：balanced。
# off：收敛工具；balanced：增强工具，无方法论；
# methodology：增加方法论；max：方法论并覆盖压缩阈值为 0.7。
# general 工具输出基数按档位乘 1 / 2 / 2 / 4；
# code profile 的工具输出有独立默认值，见运行指南。
# OSM_MODE=balanced
# SUPERPOWER_MODE 为旧别名；不再推荐 SUPERPOWER_ENABLED。
# 不能用旧预算倍率表解释当前任务截止或上下文窗口。

# 权限模式默认 standard；非法值回落 safe。
# full-access 仍受删除命令硬拦、租户与工作区授权约束。
# DEFAULT_SECURITY_MODE=standard

# 记忆能力开关不等于启用用户记忆。全局/会话策略默认关闭；
# 应由设置和会话 memoryScope 明确选择，不能仅靠此变量开启召回。
# ENABLE_LONG_TERM_MEMORY=true

# Skills 根路径未显式指定时由注册器探测 .aether/skills 等部署路径。
# SKILLS_ROOT=./skills
# MCP_CONFIG_PATH=./mcp.config.json
# BASH_PATH=C:/Program Files/Git/bin/bash.exe

# LOG_LEVEL=info
# QA_LOG_ENABLED=true
# QA_LOG_DIR=./logs/qa
# QA 日志可能包含输入/输出；测试报告使用 .e2e-tmp/<任务名>/，不要发布原始凭据。
