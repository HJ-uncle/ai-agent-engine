# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: openai | anthropic
LLM_PROVIDER=openai
LLM_PRIMARY_MODEL=gpt-4o

# OpenAI (or compatible proxy)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (optional, if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=file:./data/agent.db

# ── Agent ────────────────────────────────────────────────────────────────────
MAX_ITERATIONS=15
TOKEN_BUDGET=80000

# ── Skills ───────────────────────────────────────────────────────────────────
# Absolute or relative path to the skills directory
SKILLS_ROOT=./skills

# Path to bash executable (required for run_skill_script on Windows)
BASH_PATH=C:/Program Files/Git/bin/bash.exe

# ── Auth (optional) ───────────────────────────────────────────────────────────
# JWT_SECRET=your-secret-here

# ── Observability ─────────────────────────────────────────────────────────────
QA_LOG_ENABLED=false
QA_LOG_DIR=./logs/qa