{
  "openapi": "3.0.0",
  "info": {
    "title": "AI Agent Engine API",
    "version": "1.0.0",
    "description": "用于与 AI Agent 引擎交互、管理智能体、知识库、MCP、记忆、任务和对话的标准化 API。"
  },
  "servers": [
    {
      "url": "http://localhost:12323/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "StandardResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "操作成功"
          },
          "data": {
            "type": "object"
          },
          "timestamp": {
            "type": "integer",
            "example": 1745222400000
          }
        }
      },
      "PaginatedResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "查询成功"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "pagination": {
            "type": "object",
            "properties": {
              "current": {
                "type": "integer",
                "example": 1
              },
              "pageSize": {
                "type": "integer",
                "example": 10
              },
              "total": {
                "type": "integer",
                "example": 25
              },
              "totalPages": {
                "type": "integer",
                "example": 3
              }
            }
          },
          "timestamp": {
            "type": "integer",
            "example": 1745222400000
          }
        }
      }
    }
  },
  "paths": {
    "/chat": {
      "post": {
        "summary": "发送消息（SSE 流式响应）",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": { "type": "string" },
                  "sessionId": { "type": "string" },
                  "agentId": { "type": "string" },
                  "systemPrompt": { "type": "string" },
                  "maxAskUserCount": { "type": "integer" },
                  "thinkingMode": { "type": "boolean" },
                  "toolResponse": {
                    "type": "object",
                    "properties": {
                      "toolCallId": { "type": "string" },
                      "name": { "type": "string" },
                      "output": { "type": "string" }
                    }
                  }
                },
                "required": ["message"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSE 流式响应（text/event-stream）"
          }
        }
      }
    },
    "/agents": {
      "get": {
