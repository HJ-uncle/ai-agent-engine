# ── 基础配置 ───────────────────────────────────────────────────────────────────
# OIDC Issuer URL（必须与外部访问地址一致）
ISSUER_URL="http://localhost:3000"
# 服务器端口
PORT="3000"
# 数据目录（SQLite + 签名密钥存储）
DATA_DIR="./data"
# 管理员令牌（用于管理客户端，至少 16 字符）
ADMIN_TOKEN="please-change-to-a-long-random-string"

# ── TTL 配置（可选）───────────────────────────────────────────────────────────
# 会话过期时间（秒），默认 12 小时
# SESSION_TTL_SECONDS=43200
# 授权码过期时间（秒），默认 5 分钟
# AUTH_CODE_TTL_SECONDS=300
# Access Token 过期时间（秒），默认 15 分钟
# ACCESS_TOKEN_TTL_SECONDS=900
# ID Token 过期时间（秒），默认 15 分钟
# ID_TOKEN_TTL_SECONDS=900

# ── 认证提供商 ───────────────────────────────────────────────────────────────
# 使用真实 Supabase 邮箱 OTP（生产环境）
# AUTH_PROVIDER="supabase"
# 使用本地测试模式，验证码固定为 000000（开发环境）
AUTH_PROVIDER="fake"

# ── Supabase 配置（AUTH_PROVIDER="supabase" 时需要）────────────────────────────
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_ANON_KEY="xxxxx"

# 注意：CLIENT_ID 和 REDIRECT_URI 是通过管理接口配置的，不在环境变量中