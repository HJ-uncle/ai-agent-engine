{
  "name": "ai-agent-engine",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "chcp 65001 && tsx watch src/main.ts",
    "build": "tsc",
    "start": "chcp 65001 && node dist/main.js",
    "db:migrate": "tsx src/storage/sqlite/migrate.ts",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test:conv": "tsx sdk/test-conversation-id.ts",
    "test:skills": "tsx sdk/test-skills.ts",
    "test:knowledge": "tsx sdk/test-knowledge.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20",
    "@fastify/cors": "^9",
    "@fastify/swagger": "^9",
    "@fastify/swagger-ui": "^4",
    "@libsql/client": "^0.17.2",
    "fastify": "^5",
    "jose": "^5",
    "openai": "^4",
    "pino": "^8",
    "pino-pretty": "^13.1.3",
    "uuid": "^9",
    "vscode-icons-js": "^11.6.1",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "7.6",
    "@typescript-eslint/parser": "7.6",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
