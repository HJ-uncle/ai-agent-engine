# ── API Configuration ─────────────────────────────────────────────────────────
# 后端API地址（开发环境留空，使用setupProxy.js代理）
REACT_APP_API_URL=

# ── OIDC Configuration ───────────────────────────────────────────────────────
# OIDC服务地址
REACT_APP_OIDC_ISSUER_URL=http://localhost:3000
# OIDC客户端ID
REACT_APP_OIDC_CLIENT_ID=multi-agent-console
